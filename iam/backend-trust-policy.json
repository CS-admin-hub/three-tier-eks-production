{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::851725602228:oidc-provider/<OIDC_URL>"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "<OIDC_URL>:sub": "system:serviceaccount:workshop:backend-sa"
        }
      }
    }
  ]
}